# ─────────────────────────────────────────────────────────────────────────────
# Inkinspire environment variables
#
# Copy to `.env` for local development. In production, set these in your host's
# dashboard (Vercel: Project → Settings → Environment Variables). Never commit
# real values. Everything marked (optional) can be added later: the site works
# without it and Studio › Settings › Connected services shows what is missing.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (required) ──────────────────────────────────────────────────────────

# PostgreSQL connection string. Neon: use the *pooled* connection string
# (the host contains "-pooler"), with ?sslmode=require.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/inkinspire

# The public address of the site, no trailing slash. Used in emails, sitemaps,
# share cards and sign-in links. On Vercel you can leave it empty until you add
# a custom domain: the project's own *.vercel.app address is used automatically
# (and such preview addresses are kept out of search engines).
SITE_URL=http://localhost:3000

# Signs sessions and encrypts two-step verification secrets. 32+ random
# characters. Generate with:  openssl rand -base64 36
# Changing it signs everyone out and invalidates two-step set-ups.
BETTER_AUTH_SECRET=

# Salt for one-way hashing of IP addresses and anonymous visitor ids.
# Generate with:  openssl rand -hex 16
HASH_SALT=

# Protects the minute job at /api/cron/tick. Generate with:  openssl rand -hex 24
# Give the same value to your scheduler (cron-job.org) as "Authorization: Bearer <value>".
CRON_SECRET=

# ── Owner account on first deploy (optional) ───────────────────────────────
# If set, the first deploy creates the owner account with a one-time password
# printed once in the build log. Nothing happens once an owner exists.
OWNER_EMAIL=
OWNER_NAME="Sylvia Simon"

# ── Email: Resend (optional until launch) ────────────────────────────────────
# Without a key, emails are queued and printed in the development console.
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend.
EMAIL_FROM="Inkinspire <stories@inkinspire.com>"
EMAIL_REPLY_TO=
# Resend's free plan sends 100 emails a day. Raise this if you upgrade.
EMAIL_DAILY_LIMIT=100
RESEND_WEBHOOK_SECRET=

# ── Images: Cloudflare R2 (required in production) ───────────────────────────
# Without these, images are stored in ./.local-media (development only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public address, e.g. https://media.inkinspire.com
R2_PUBLIC_URL=

# ── Spam protection: Cloudflare Turnstile (optional) ─────────────────────────
# Without keys, forms still use honeypots, timing checks and rate limits.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Payments: Paystack (Phase 3) ─────────────────────────────────────────────
# Test keys start with sk_test_ / pk_test_. Live keys only after sandbox sign-off.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ── Analytics (optional) ─────────────────────────────────────────────────────
# Google Analytics 4 loads only for readers who accept analytics cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# The content of Google Search Console's HTML-tag verification (just the code).
GOOGLE_SITE_VERIFICATION=

# ── Backups (GitHub Actions secrets, not app variables) ──────────────────────
# Set these as repository secrets for .github/workflows/scheduled.yml:
#   BACKUP_DATABASE_URL  direct (non-pooled) Neon connection string
#   BACKUP_AGE_RECIPIENT age public key (age1…); keep the private key offline
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BACKUP_BUCKET
#   SITE_URL, CRON_SECRET  (for the hourly backup call to the minute job)

# ── Development only ─────────────────────────────────────────────────────────
# Set to fix the seeded owner's password (otherwise a random one is printed).
# SEED_OWNER_EMAIL=owner@inkinspire.local
# SEED_OWNER_PASSWORD=
